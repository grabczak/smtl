# Comment

# Logic (QF_LIA or QF_NIA)
set logic QF_NIA

# Declarations
var p, q : bool
var m, n : int

# Assignments
let f = (p \/ ~p) /\ (F => T)
let g = (q /\ ~q) \/ (p <=> q)
let h = m * m + 1 < -5 * n

# Assertions
assert f /\ g
assert h
assert (m > 0 /\ n >= 0) \/ (m < 0 /\ n <= 0)
assert (m == n) /\ n != -2

# Output commands
check sat
get model
exit
